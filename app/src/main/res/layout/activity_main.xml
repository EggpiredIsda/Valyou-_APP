<?xml version="1.0" encoding="utf-8"?>
<!--
    Full-screen map.
    Interaction: MapEventsOverlay fires singleTapConfirmedHelper → proximity check → onAreaSelected().
    Layout: CoordinatorLayout hosts the map + floating search bar + half-expanded BottomSheet.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Dark-themed search bar floated over the map -->
    <LinearLayout
        android:id="@+id/llSearch"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_gravity="top"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="44dp"
        android:background="@drawable/bg_map_search"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="10dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_search"
            android:alpha="0.6"
            android:contentDescription="Search"/>

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@null"
            android:hint="Search area in Cebu…"
            android:textColorHint="#555550"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:maxLines="1"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:inputType="text"/>

        <TextView
            android:id="@+id/tvClear"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="✕"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:gravity="center"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <!-- Suggestion dropdown -->
    <LinearLayout
        android:id="@+id/llSuggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="104dp"
        android:background="@color/surface"
        android:elevation="10dp"
        android:orientation="vertical"
        android:visibility="gone"/>

    <!-- First-use hint, fades out after first area selection -->
    <TextView
        android:id="@+id/tvHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="110dp"
        android:background="@drawable/bg_card"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:text="Tap a highlighted area to analyse"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:elevation="4dp"/>

    <!-- Custom zoom controls — OSMdroid built-in is disabled in code -->
    <LinearLayout
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="32dp"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:elevation="6dp">

        <TextView
            android:id="@+id/btnZoomIn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="+"
            android:gravity="center"
            android:textColor="@color/text_white"
            android:textSize="22sp"
            android:clickable="true"
            android:focusable="true"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"/>

        <TextView
            android:id="@+id/btnZoomOut"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="−"
            android:gravity="center"
            android:textColor="@color/text_white"
            android:textSize="22sp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <!--
        Bottom sheet — starts HIDDEN, opens at HALF_EXPANDED (map visible above).
        isFitToContents=false and halfExpandedRatio=0.56 are set in code.
    -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_bottom_sheet"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_hideable="true"
        app:behavior_skipCollapsed="true"
        app:behavior_peekHeight="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="48dp">

            <!-- Grab handle -->
            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="20dp"
                android:background="#44FFFFFF"
                android:clickable="false"/>

            <!-- Area name + close -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="22dp"
                android:paddingEnd="18dp"
                android:layout_marginBottom="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MARKET VALUE"
                        android:textColor="@color/text_dim"
                        android:textSize="9sp"
                        android:letterSpacing="0.12"/>

                    <TextView
                        android:id="@+id/tvAreaName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Select a location"
                        android:textColor="@color/text_white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/btnCloseSheet"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="✕"
                    android:gravity="center"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp"
                    android:background="@drawable/bg_badge"
                    android:clickable="true"
                    android:focusable="true"/>

            </LinearLayout>

            <!-- Red accent line -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1.5dp"
                android:layout_marginStart="22dp"
                android:layout_marginEnd="22dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="16dp"
                android:background="@color/brand_red"/>

            <!-- Idle state -->
            <LinearLayout
                android:id="@+id/llIdle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="16dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_pin"
                    android:alpha="0.2"
                    android:contentDescription="Pin"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Tap a highlighted area on the map"
                    android:textColor="@color/text_dim"
                    android:textSize="13sp"
                    android:gravity="center"/>

            </LinearLayout>

            <!-- Value data -->
            <LinearLayout
                android:id="@+id/llValueData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvEstValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PHP —"
                    android:textColor="@color/text_white"
                    android:textSize="38sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvEstRange"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:id="@+id/tvPriceSqm"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="₱ —/sqm"
                        android:textColor="@color/brand_red"
                        android:textSize="12sp"
                        android:textStyle="bold"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_badge"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp">

                        <ImageView
                            android:id="@+id/ivTrendArrow"
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:src="@drawable/ic_arrow_up"
                            android:layout_marginEnd="3dp"
                            android:contentDescription="Trend"/>

                        <TextView
                            android:id="@+id/tvTrend"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+0.0%"
                            android:textColor="@color/green"
                            android:textSize="11sp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="14dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="NEARBY PROPERTIES"
                    android:textColor="@color/text_dim"
                    android:textSize="9sp"
                    android:letterSpacing="0.12"/>

                <TextView
                    android:id="@+id/tvListingCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/brand_red"
                    android:textSize="11sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tvNearbyIdle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:text="Tap an area on the map to see nearby listings"
                android:textColor="@color/text_dim"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.4"/>

            <LinearLayout
                android:id="@+id/llNearbyList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="4dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
